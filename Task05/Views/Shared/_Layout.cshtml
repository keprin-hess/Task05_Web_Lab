<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Book Store</title>
    <!-- Bootstrap CSS link -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Navbar with brand and 3 links -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" href="/Home/Index">Book Store</a>
                <div class="navbar-nav">
                    <a class="nav-link text-dark" href="/Home/Index">Home</a>
                    <a class="nav-link text-dark" href="/Home/About">About</a>
                    <a class="nav-link text-dark" href="/Home/Contact">Contact</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">

            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer text-muted bg-light py-3 mt-5">
        <div class="container text-center">
            Hassan - BSEF24M008 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>